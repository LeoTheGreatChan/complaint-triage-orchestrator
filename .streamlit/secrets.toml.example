# Template only -- copy to .streamlit/secrets.toml (already git-ignored) and
# fill in your own values. Never commit the copy.
#
# These three fields come from running scripts/get_google_oauth_refresh_token.py
# once (see the main README's "Live dashboard data source" section for the
# full walkthrough): it drives a one-time interactive Google consent flow
# using a dedicated OAuth 2.0 Client ID (Desktop app type, Internal consent
# screen, scoped to spreadsheets.readonly) and writes this exact block
# directly into .streamlit/secrets.toml on your machine -- the script never
# prints the values to the terminal, and nothing here should ever be typed
# into a chat, ticket, or committed file.
#
# In production, don't put this file on the server either: paste the same
# three fields into your host's own secret manager instead (Streamlit
# Community Cloud's app "Secrets" panel, Render's "Secret Files" mounted at
# .streamlit/secrets.toml, etc.) -- never into anything git tracks.
[gcp_oauth_client]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
refresh_token = "your-refresh-token"
